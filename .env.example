# ==========================================
# VD Stats - Configuração de Ambiente
# ==========================================

# Banco de Dados
DATABASE_URL="host=localhost user=SEU_USER password=SUA_SENHA dbname=vd_stats port=5432 sslmode=disable TimeZone=UTC"

# Servidores Alvo (Separe os IPs das VPS por vírgula)
# Deixe apenas 1 IP se for um ambiente Isolado (Sem Cluster)
TARGET_VPS_IPS="10.0.0.1,10.0.0.2"

# Load Balancer
# Deixe vazio se não possuir um Load Balancer (Ambiente Isolado)
LB_IP="10.0.0.3"

# Autenticação SSH para conexão
SSH_USER="root"
SSH_KEY_PATH="~/.ssh/sua_chave_ssh"
